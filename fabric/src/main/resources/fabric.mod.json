{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "BerdinskiyBear",
    "uku",
    "AnAwesomGuy"
  ],
  "contact": {
    "homepage": "https://github.com/uku3lig/armor-hud",
